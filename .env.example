# Copia questo file in .env e adatta i valori. Il file .env non va mai nel repository.
# I segreti (password, chiavi) NON stanno qui: vanno nei file di infra/secrets/ (vedi infra/secrets/README.md).

# Versione dell'immagine da avviare in produzione
GC_VERSIONE=0.1.0

# Nome con cui l'app è raggiungibile in rete locale (solo informativo nella 1.0: Caddy risponde su qualsiasi nome)
GC_NOME_HOST=casa.lan
# Porta HTTP esposta dal server
GC_PORTA_HTTP=80

# Database
GC_DB_NOME=gestione_casa
GC_DB_UTENTE=gestione_casa

# Mail (Gmail con password per le app)
GC_SMTP_HOST=smtp.gmail.com
GC_SMTP_PORTA=587
GC_SMTP_UTENTE=indirizzo.dedicato@gmail.com
GC_MAIL_MITTENTE=Gestione casa <indirizzo.dedicato@gmail.com>

# Fuso orario (fisso nella 1.0)
TZ=Europe/Rome
