# Reverse proxy e file statici del frontend.
# Versione 1.0: solo HTTP in rete locale (paragrafo 9 del documento iniziale, ADR 0003).
# Per la 2.0 basterà sostituire ":80" con il nome pubblico e togliere "auto_https off".
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API e WebSocket verso il backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Frontend: file statici con ripiego su index.html per le rotte dell'app
	handle {
		root * /srv
		@asset path /assets/*
		header @asset Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
